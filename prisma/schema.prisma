generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Semua nominal uang disimpan sebagai Int dalam rupiah.

// ───────────────────────── Akun ─────────────────────────

enum Role {
  ADMIN
  SPV
  CUSTOMER
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  /// Kosong untuk akun pembeli yang dibuat lewat Google (hanya bisa masuk lewat Google).
  passwordHash   String?
  /// ID akun Google (claim `sub`), tetap walaupun email di Google diganti.
  googleId       String?  @unique
  /// Naik setiap password diganti/di-reset. Sesi (JWT) dengan versi lama dianggap keluar.
  sessionVersion Int      @default(0)
  role           Role     @default(CUSTOMER)
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses       Address[]
  cartItems       CartItem[]
  orders          Order[]
  reviews         Review[]
  reviewReplies   Review[]        @relation("ReviewReplier")
  returnRequests  ReturnRequest[]
  handledReturns  ReturnRequest[] @relation("ReturnHandler")
  conversations   Conversation[]
  messages        Message[]
  stockMovements  StockMovement[]
  changeRequests  ChangeRequest[] @relation("ChangeRequester")
  reviewedChanges ChangeRequest[] @relation("ChangeReviewer")
  auditLogs       AuditLog[]
  authTokens      AuthToken[]

  @@index([role])
  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Rumah")
  recipient  String
  phone      String
  street     String
  city       String
  province   String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────── Katalog ─────────────────────────

enum Gender {
  PRIA
  WANITA
  UNISEX
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  brand       String
  description String?
  basePrice   Int
  // Harga modal per pasang, diisi admin di form produk. Disalin ke avgCost tiap
  // varian, yang dipakai menghitung modal saat order dibayar. 0 = belum diisi.
  costPrice   Int       @default(0)
  gender      Gender    @default(UNISEX)
  isPublished Boolean   @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  discounts     Discount[]
  reviews       Review[]
  conversations Conversation[]

  @@index([categoryId])
  @@index([isPublished, createdAt])
  @@index([gender])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  sku       String   @unique
  stock     Int      @default(0)
  // Harga modal rata-rata bergerak; diperbarui tiap barang masuk.
  avgCost   Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  movements  StockMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

// ───────────────────────── Stok ─────────────────────────

enum StockMovementType {
  IN // barang masuk dari pemasok
  OUT // barang keluar non-penjualan (rusak, hilang, sampel)
  SALE // terjual lewat order
  RESTOCK // dikembalikan ke stok (order batal/kedaluwarsa atau retur)
  ADJUSTMENT // koreksi hasil hitung ulang
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  // Selisih bertanda: positif menambah stok, negatif mengurangi.
  quantity    Int
  stockAfter  Int
  unitCost    Int?
  note        String?
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ───────────────────────── Harga, diskon, persetujuan ─────────────────────────

enum DiscountType {
  PERCENT
  FIXED
}

model Discount {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      DiscountType
  value     Int
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([productId, isActive])
  @@map("discounts")
}

enum ChangeRequestType {
  PRICE_CHANGE
  DISCOUNT
  STOCK_CORRECTION
  ORDER_CORRECTION
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ChangeRequest {
  id            String              @id @default(cuid())
  type          ChangeRequestType
  status        ChangeRequestStatus @default(PENDING)
  // Ringkasan yang bisa dibaca manusia, mis. "Harga Aero Run: Rp 750.000 → Rp 699.000".
  summary       String
  // Data perubahan; bentuknya divalidasi dengan Zod sesuai `type` sebelum diterapkan.
  payload       Json
  reason        String
  requestedById String
  requestedBy   User                @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?               @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("change_requests")
}

// ───────────────────────── Keranjang & order ─────────────────────────

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Int
  discountTotal Int         @default(0)
  shippingCost  Int         @default(0)
  total         Int

  // Salinan alamat saat checkout, supaya order lama tidak berubah kalau alamat diedit.
  shipRecipient  String
  shipPhone      String
  shipStreet     String
  shipCity       String
  shipProvince   String
  shipPostalCode String
  courier        String?
  trackingNumber String?
  note           String?

  expiresAt        DateTime
  paidAt           DateTime?
  processedAt      DateTime?
  shippedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  /// Terakhir kali invoice dikirim ke email pembeli (otomatis saat dibayar, atau kirim ulang).
  invoiceEmailedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items          OrderItem[]
  payment        Payment?
  stockMovements StockMovement[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paidAt])
  @@map("orders")
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId      String
  // Salinan data produk saat dibeli.
  productName    String
  size           String
  color          String
  // Harga dasar per pasang, potongan per pasang, dan harga modal per pasang.
  unitPrice      Int
  discountAmount Int            @default(0)
  unitCost       Int            @default(0)
  quantity       Int

  review         Review?
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("midtrans")
  status        PaymentStatus @default(PENDING)
  grossAmount   Int
  snapToken     String?
  redirectUrl   String?
  transactionId String?
  method        String?
  rawPayload    Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

model ShippingRate {
  id       String @id @default(cuid())
  province String @unique
  cost     Int

  @@map("shipping_rates")
}

// ───────────────────────── Review, retur, chat ─────────────────────────

model Review {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  isHidden    Boolean   @default(false)
  reply       String?
  repliedById String?
  repliedBy   User?     @relation("ReviewReplier", fields: [repliedById], references: [id], onDelete: SetNull)
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([productId, isHidden])
  @@index([createdAt])
  @@map("reviews")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity     Int
  reason       String
  photoUrls    String[]
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int?
  handledById  String?
  handledBy    User?        @relation("ReturnHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handlerNote  String?
  refundedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([orderItemId])
  @@map("return_requests")
}

model Conversation {
  id            String   @id @default(cuid())
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Kosong = chat umum dari tombol chat melayang (satu per pembeli, dijaga index
  // parsial di migrasi). Terisi = chat lama yang dibuka dari halaman produk.
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Bot menjawab selama aktif. Mati otomatis begitu staf membalas atau pembeli minta staf.
  botEnabled    Boolean  @default(true)
  // Pembeli menunggu balasan staf (diminta pembeli, diserahkan bot, atau bot tidak tersedia).
  needsStaff    Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([customerId, productId])
  @@index([lastMessageAt])
  @@index([needsStaff])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Kosong untuk pesan dari bot.
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  isBot          Boolean      @default(false)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ───────────────────────── Riwayat perubahan ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

/// Token sekali pakai yang dikirim lewat email (reset password, konfirmasi email baru).
/// Yang disimpan hanya hash SHA-256-nya; token aslinya hanya ada di link email.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  /// Untuk EMAIL_CHANGE: alamat email baru yang menunggu konfirmasi.
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type, createdAt])
  @@map("auth_tokens")
}

// Penghitung percobaan per kunci (hash dari jenis + email/IP). `resetAt` dalam milidetik epoch.
model RateLimit {
  key     String @id
  count   Int    @default(0)
  resetAt BigInt

  @@index([resetAt])
  @@map("rate_limits")
}
