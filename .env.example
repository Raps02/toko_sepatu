# Database (PostgreSQL dari docker-compose.yml, port host 5433)
DATABASE_URL=""

# Auth.js: buat dengan `openssl rand -base64 33`
AUTH_SECRET=""

# Alamat publik website (dipakai untuk link balik dari halaman pembayaran)
APP_URL="http://localhost:3000"

# Midtrans Snap: Server Key dari dashboard Midtrans (Settings > Access Keys).
# Selama kosong, pembayaran online mati dan di development muncul tombol
# "Tandai dibayar (uji coba)" di halaman pesanan.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Bot chat toko (OpenAI). Selama kosong, bot mati dan semua chat langsung ditandai
# "butuh staf" di dashboard. Jangan pernah commit key asli.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Alamat API. Biarkan default untuk OpenAI langsung; isi base URL gateway (yang
# kompatibel OpenAI) kalau key-nya dari platform lain, mis. "https://<gateway>/v1".
OPENAI_BASE_URL=""

# Lacak paket SIMULASI (src/lib/tracking.ts).
# "demo" (default): kabar perjalanan baru muncul tiap 5-10 detik setelah pesanan dikirim.
# "realtime": mengikuti jam perjalanan (sampai Jawa sekitar 1,5 hari); TRACKING_SIM_SPEED mempercepatnya.
TRACKING_SIM_PACE="demo"
TRACKING_SIM_SPEED="1"

# Login dengan Google (khusus pembeli). Kosongkan untuk menyembunyikan tombol Google.
# Buat di Google Cloud Console > Google Auth Platform > Clients (tipe "Web application"),
# redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email transaksional lewat Brevo (lupa kata sandi, konfirmasi email baru, pemberitahuan keamanan).
# Kosongkan saat development: link dari email ditampilkan langsung di halaman.
# EMAIL_FROM harus alamat pengirim yang sudah diverifikasi di Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Langkah Kaki"
